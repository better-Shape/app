{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BetterShape",
  "version": "1.0.3",
  "identifier": "com.bettershape.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:48921",
    "beforeDevCommand": "node scripts/build/preview.mjs && node scripts/kill-stale.mjs && npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BetterShape",
        "visible": false,
        "width": 1000,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset:",
        "base-uri": "'self'",
        "object-src": "'none'",
        "frame-ancestors": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost http://tauri.localhost https://tauri.localhost http://asset.localhost https://asset.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* wss: https:",
        "font-src": "'self' data: https://fonts.gstatic.com http://localhost:* http://127.0.0.1:*",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost blob: data: https: http://localhost:* http://127.0.0.1:*",
        "style-src": "'unsafe-inline' 'self' https://fonts.googleapis.com http://localhost:* http://127.0.0.1:*",
        "style-src-attr": "'unsafe-inline'",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval' asset: http://asset.localhost https://asset.localhost http://localhost:* http://127.0.0.1:*",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob: asset: http://asset.localhost https://asset.localhost http://localhost:* http://127.0.0.1:* https: http:",
        "frame-src": "'self' blob: asset: http://asset.localhost https://asset.localhost http://localhost:* http://127.0.0.1:* https: http:"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$APPDATA/**",
          "$LOCALAPPDATA/**",
          "$TEMP/**"
        ]
      },
      "capabilities": [
        "default"
      ]
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "bettershape"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libsoup-3.0-0",
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libsoup3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
