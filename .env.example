# BetterShape keeps everything local: model providers are called with the keys
# you add in Settings → Providers, so there is no server URL or build secret to
# configure. This file only holds optional front-end build metadata.

# Optional: release label shown in diagnostics.
NEXT_PUBLIC_SHAPE_RELEASE=""

# Browser Preview only (local dev / PR previews, never set for Tauri
# release builds): set to 1 by `npm run dev:browser` / `npm run
# build:preview` to install the mocked Tauri IPC bridge from
# lib/preview/tauri-mock.ts. See docs/developing/browser-preview.mdx.
# NEXT_PUBLIC_BROWSER_PREVIEW=""
