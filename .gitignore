# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
src-tauri/target/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# playwright / browser preview QA (reports & traces; visual baselines under
# e2e/visual.spec.ts-snapshots/ ARE committed on purpose)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# generated capture output: GIFs, contact sheets, frame sequences and the spring
# comparison page. Re-record with scripts/qa/make-gifs.cjs, scripts/qa/shot-*.cjs
# and scripts/motion/compare.cjs --write. The documents beside them are tracked.
/.dump/app/qa/
/scripts/motion/compare.html

# typescript
*.tsbuildinfo
next-env.d.ts

# Shape
.shape/
.bettershape/

# Local commit wording (not published)
COMMIT.md

# Updater signing private key (never commit)
src-tauri/.updater-keys/shape.key
src-tauri/.updater-keys/*.key
!src-tauri/.updater-keys/*.key.pub

# Preview deploy job: lockfile-pinned Vercel CLI (installed in CI only)
.github/vercel-cli/node_modules/
